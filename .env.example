# Padrões de desenvolvimento. Troque as senhas antes de usar em produção (T6.5).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_DB=clinica

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=clinica
RABBITMQ_PASSWORD=clinica
RABBITMQ_VHOST=/

AGENDA_ANTECEDENCIA_MINIMA_MIN=120
AGENDA_DURACAO_HOLD_MIN=3

API_PORT=8000

# Quem pode falar com a API (T5.1). Padrões de desenvolvimento: troque antes de usar em produção.
API_TOKEN_PAINEL=token-do-painel-de-desenvolvimento
API_TOKEN_SERVICOS=token-dos-servicos-de-desenvolvimento

# Painel. Assina o cookie de sessão: troque antes de usar em produção.
PAINEL_SEGREDO_SESSAO=segredo-de-sessao-de-desenvolvimento-troque
# Sem HTTPS na rede local, o navegador só devolve o cookie em localhost. Veja o runbook.
PAINEL_COOKIE_SEGURO=true
PAINEL_BIND=127.0.0.1
PAINEL_PORTA=8080

# Chave da API do Gemini: embeddings (e o modelo de voz, a partir da Fase 3).
GOOGLE_API_KEY=
EMBEDDING_MODELO=gemini-embedding-001

# Só para rodar o worker fora do Docker. No Compose, é o volume conhecimento_arquivos.
CONHECIMENTO_DIR=./dados/conhecimento

# Modelo de voz do agente, escolhido na T3.1.
AGENTE_MODELO_VOZ=gemini-3.1-flash-live-preview

# Silêncio, em ms, até o modelo considerar o fim da fala. Vazio: o padrão do Gemini. Ver a T3.5.
AGENTE_SILENCIO_FIM_DE_FALA_MS=

# Dias até apagar a transcrição e o telefone de cada chamada. O agente fala este prazo ao pedir o
# consentimento.
RETENCAO_TRANSCRICAO_DIAS=90

# Usuário das sessões do ADK no Postgres. Só vale na primeira criação do banco.
ADK_SESSOES_SENHA=adk_sessoes

# LiveKit. Padrões de desenvolvimento: troque antes de usar em produção.
LIVEKIT_API_KEY=clinica-dev
LIVEKIT_API_SECRET=segredo-de-desenvolvimento-troque-antes-de-usar
